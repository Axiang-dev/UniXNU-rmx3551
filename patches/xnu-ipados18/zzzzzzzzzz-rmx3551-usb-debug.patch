index 0000000..59e6e87
--- /dev/null
+++ b/bsd/dev/liuqin_usb_debug.c
@@ -0,0 +1,1027 @@
+/* Liuqin (Xiaomi Pad 6 Pro, SM8475) CDC ACM debug console.
+ *
+ * Opt-in: boot argument liuqin_usb=1. Ported from the vermeer lab console
+ * (github.com/xyyyds0106/ios-vermeer-lab, xnu/vermeer/vermeer_usb_debug.c).
+ *
+ * The port reuses the PHY and clocks that ABL/UEFI already set up. It may
+ * install one isolated translation-off SMMU context for the USB SID, but never
+ * changes GCC, PMIC, PHY or storage configuration. Every failed guard leaves the
+ * controller untouched and normal boot continues.
+ *
+ * SM8475 constants and their evidence:
+ *   DWC3           0x0a600000, wrapper window 0xfc100   linux sm8450.dtsi usb@a600000
+ *   QSCRATCH       0x0a6f8800 (base + 0xf8800)          inside that window, dwc3-qcom glue
+ *   USB30_PRIM GDSC  GCC + 0x49004                      gcc-sm8450.c usb30_prim_gdsc
+ *   master clock halt GCC + 0x49018                     gcc-sm8450.c gcc_usb30_prim_master_clk
+ *   cfg_noc halt     GCC + 0x49084                      gcc-sm8450.c gcc_cfg_noc_usb3_prim_axi_clk
+ *   aggre halt       GCC + 0x49088                      gcc-sm8450.c gcc_aggre_usb3_prim_axi_clk
+ *   GCC block base  0x149000 (GCC 0x100000 + 0x49000)   linux sm8450.dtsi clock-controller
+ *   APPS SMMU       0x15000000, window 0x100000         linux sm8450.dtsi iommu@15000000
+ *   USB stream ID   0x0                                 linux sm8450.dtsi iommus
+ *
+ * Register order and endpoint protocol follow Linux drivers/usb/dwc3 and the
+ * vermeer reference. DMA memory is permanent: a timeout never frees it.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <vm/vm_kern_xnu.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <kern/kalloc.h>
+#include <mach/thread_act.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+#include "liuqin_usb_protocol.h"
+#include "liuqin_usb_smmu.h"
+
+#define DWC3_PA        0x0a600000ULL
+#define DWC3_SIZE      0x0e000
+#define QSCRATCH_PA    0x0a6f8800ULL
+#define GCC_PA         0x149000ULL
+#define GCC_GDSC_OFF   0x04
+#define GCC_MASTER_OFF 0x18
+#define GCC_CFG_OFF    0x84
+#define GCC_AGGRE_OFF  0x88
+#define SMMU_PA        0x15000000ULL
+#define SMMU_SIZE      0x0d0000
+#define SMMU_UFS_BANK  74U
+#define USB_SID_DEF    0x00000000U
+#define DMA_LO_DEF     0x80000000ULL
+#define DMA_HI_DEF     0x100000000ULL
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern vm_offset_t liuqin_io_map(vm_offset_t, vm_size_t);
+/* liuqin: no flush_mmu_tlb symbol exists in this kernel image, do it inline */
+static void
+liuqin_tlb_flush(void)
+{
+	__asm__ volatile("dsb sy; tlbi vmalle1; dsb sy; isb" ::: "memory");
+}
+
+extern ppnum_t pmap_find_phys(pmap_t, addr64_t);
+/*
+ * Early identity mapping for MMIO through the bootstrap V=P table that start.s
+ * built and arm_vm_init left in TTBR0.
+ *
+ * ml_io_map() must not be used this early: it allocates from kernel_map, and
+ * those allocations wait for the pageout thread, which only starts at the end of
+ * kernel_bootstrap_thread. Mapping the framebuffer there hung the boot at
+ * bsd_init. GCC (0x149000), DWC3 (0xa600000) and the SMMU (0x15000000) all live
+ * in L1 slot 0, which the bootstrap table leaves empty, so one private L2 page
+ * covers them. Slots that already hold a table are refused rather than patched.
+ */
+extern uint8_t bootstrap_pagetables[];
+
+static uint64_t lq_io_l2[512] __attribute__((aligned(4096)));
+static bool lq_io_l2_used;
+
+vm_offset_t
+liuqin_io_map(vm_offset_t pa, vm_size_t size)
+{
+	(void)lq_io_l2;
+	(void)lq_io_l2_used;
+	return (vm_offset_t)ml_io_map(pa, size);
+}
+
+extern ppnum_t pmap_find_phys(pmap_t, addr64_t);
+extern unsigned liuqin_debug_copy(uint64_t *, char *, unsigned);
+extern uint64_t liuqin_debug_total(void);
+extern uint64_t liuqin_debug_dropped(void);
+extern void liuqin_fb_bind(uint64_t, uint32_t, uint32_t, uint32_t);
+extern void liuqin_fb_band(unsigned, uint32_t);
+extern bool pong_smmu_lease_lock(void);
+extern void pong_smmu_lease_unlock(void);
+void liuqin_usb_debug_start(void);
+
+#define GCTL        0xc110
+#define GEVNTADRLO  0xc400
+#define GEVNTADRHI  0xc404
+#define GEVNTSIZ    0xc408
+#define GEVNTCOUNT  0xc40c
+#define DCFG        0xc700
+#define DCTL        0xc704
+#define DEVTEN      0xc708
+#define DSTS        0xc70c
+#define DALEPENA    0xc720
+#define EPBASE(n)   (0xc800 + 16 * (n))
+
+#define RUN          (1u << 31)
+#define RESET        (1u << 30)
+#define HALTED       (1u << 22)
+#define ACTIVE       (1u << 10)
+#define FORCE_REMOVE (1u << 11)
+
+#define SET_CONFIG   1
+#define SET_RESOURCE 2
+#define STALL        4
+#define CLEAR_STALL  5
+#define START        6
+#define END          8
+#define START_CONFIG 9
+
+#define T_NORMAL   (1u << 4)
+#define T_SETUP    (2u << 4)
+#define T_STATUS2  (3u << 4)
+#define T_STATUS3  (4u << 4)
+#define T_DATA     (5u << 4)
+#define HWO        1u
+#define TRB_FLAGS  (HWO | 2u | (1u << 10) | (1u << 11))
+
+#define EVENTS      0
+#define EVENT_SIZE  4096
+#define SETUP       0x1200
+#define DATA        0x1300
+#define NOTIFY      0x1500
+#define RX          0x1800
+#define TX          0x2000
+#define RX_SIZE     512
+#define TX_SIZE     2048
+#define DMA_SIZE    0x4000
+
+static const unsigned trb_off[6] = { 0x1000, 0x1040, 0x1080, 0x10c0, 0x1100, 0x1140 };
+static const char *const usb_strings[] = { NULL, "Liuqin Lab", "Liuqin XNU Debug", "LIQDBG001" };
+
+static struct {
+	vm_offset_t regs, dma, smmu;
+	uint64_t pa, cursor, tx_bytes, rx_bytes;
+	uint64_t dma_lo, dma_hi;
+	uint32_t pos, events, setups, mps, sid;
+	unsigned resource[6], requested[6];
+	bool busy[6], failed, configured, dtr, notify;
+	enum { SETUP_PHASE, DATA_PHASE, WAIT2, WAIT3, STATUS_PHASE } phase;
+	bool data_in, set_line;
+	uint8_t coding[7];
+	char command[64];
+	unsigned command_n;
+	bool command_overflow;
+	int sleep_channel;
+} u;
+
+static uint32_t
+read_reg(vm_offset_t base, unsigned off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+static uint32_t
+rd(unsigned off)
+{
+	return read_reg(u.regs, off);
+}
+static void
+wr(unsigned off, uint32_t v)
+{
+	*(volatile uint32_t *)(u.regs + off) = v;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+static void
+sync_dma(unsigned off, unsigned size)
+{
+	flush_dcache64((addr64_t)(u.pa + off), size, TRUE);
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+static void
+fail(const char *why)
+{
+	if (!u.failed) {
+		printf("LIUQIN USB: stopped: %s; permanent DMA retained\n", why);
+	}
+	u.failed = true;
+}
+static int
+epcmd(unsigned ep, unsigned cmd, uint32_t p0, uint32_t p1, uint32_t p2)
+{
+	if (u.failed || ep >= 6) {
+		return -1;
+	}
+	wr(EPBASE(ep) + 8, p0);
+	wr(EPBASE(ep) + 4, p1);
+	wr(EPBASE(ep), p2);
+	wr(EPBASE(ep) + 12, cmd | ACTIVE);
+	for (unsigned n = 0; n < 1000; n++) {
+		uint32_t v = rd(EPBASE(ep) + 12);
+		if (!(v & ACTIVE)) {
+			if ((v >> 12) & 15) {
+				fail("endpoint command status");
+				return -1;
+			}
+			if ((cmd & 15) == START) {
+				u.resource[ep] = (v >> 16) & 0x7f;
+			}
+			return 0;
+		}
+		delay(1);
+	}
+	fail("endpoint command timeout");
+	return -1;
+}
+static void
+transfer(unsigned ep, unsigned buf, unsigned length, unsigned kind)
+{
+	if (u.failed) {
+		return;
+	}
+	if (ep >= 6 || u.busy[ep] || buf > DMA_SIZE || length > DMA_SIZE - buf) {
+		fail("transfer ownership/bounds");
+		return;
+	}
+	unsigned off = trb_off[ep];
+	uint64_t p = u.pa + buf, t = u.pa + off;
+	volatile uint32_t *trb = (volatile uint32_t *)(u.dma + off);
+	trb[0] = (uint32_t)p;
+	trb[1] = (uint32_t)(p >> 32);
+	trb[2] = length;
+	trb[3] = kind | TRB_FLAGS;
+	u.requested[ep] = length;
+	if (length) {
+		sync_dma(buf, length);
+	}
+	sync_dma(off, 16);
+	u.busy[ep] = true;
+	(void)epcmd(ep, START, (uint32_t)(t >> 32), (uint32_t)t, 0);
+}
+static int
+complete(unsigned ep)
+{
+	if (ep >= 6 || !u.busy[ep]) {
+		fail("unexpected completion");
+		return -1;
+	}
+	sync_dma(trb_off[ep], 16);
+	volatile uint32_t *t = (volatile uint32_t *)(u.dma + trb_off[ep]);
+	unsigned left = t[2] & 0xffffff;
+	if ((t[3] & HWO) || (t[2] >> 28) || left > u.requested[ep]) {
+		fail("invalid DMA completion");
+		return -1;
+	}
+	u.busy[ep] = false;
+	return (int)(u.requested[ep] - left);
+}
+static void
+setup_arm(void)
+{
+	u.phase = SETUP_PHASE;
+	transfer(0, SETUP, 8, T_SETUP);
+}
+static void
+stall(void)
+{
+	(void)epcmd(0, STALL, 0, 0, 0);
+	setup_arm();
+}
+static void
+receive_arm(void)
+{
+	transfer(2, RX, RX_SIZE, T_NORMAL);
+}
+static void
+stop_data(void)
+{
+	for (unsigned ep = 2; ep < 6; ep++) {
+		if (u.busy[ep]) {
+			if (!u.resource[ep] ||
+			    epcmd(ep, END | FORCE_REMOVE | (u.resource[ep] << 16), 0, 0, 0)) {
+				return;
+			}
+			u.busy[ep] = false;
+		}
+	}
+	wr(DALEPENA, 3);
+	u.configured = false;
+	u.dtr = false;
+	u.notify = false;
+}
+static void
+configure(void)
+{
+	if (u.configured || u.failed) {
+		return;
+	}
+	if (epcmd(0, START_CONFIG | (2u << 16), 0, 0, 0) ||
+	    epcmd(2, SET_CONFIG, (2u << 1) | (u.mps << 3), (1u << 8) | (2u << 25), 0) ||
+	    epcmd(2, SET_RESOURCE, 1, 0, 0) ||
+	    epcmd(3, SET_CONFIG, (2u << 1) | (u.mps << 3) | (1u << 17), (1u << 8) | (3u << 25), 0) ||
+	    epcmd(3, SET_RESOURCE, 1, 0, 0) ||
+	    epcmd(5, SET_CONFIG, (3u << 1) | (16u << 3) | (2u << 17), (1u << 8) | (8u << 16) | (5u << 25), 0) ||
+	    epcmd(5, SET_RESOURCE, 1, 0, 0)) {
+		return;
+	}
+	wr(DALEPENA, 3 | (1u << 2) | (1u << 3) | (1u << 5));
+	u.configured = true;
+	receive_arm();
+	printf("LIUQIN USB: CDC ACM configured, bulk MPS %u\n", u.mps);
+}
+static unsigned
+string_desc(unsigned index, uint8_t *data)
+{
+	if (!index) {
+		data[0] = 4;
+		data[1] = 3;
+		data[2] = 0x09;
+		data[3] = 0x04;
+		return 4;
+	}
+	if (index >= sizeof(usb_strings) / sizeof(usb_strings[0])) {
+		return 0;
+	}
+	unsigned n = 2;
+	for (const char *s = usb_strings[index]; *s && n < 126; s++) {
+		data[n++] = (uint8_t)*s;
+		data[n++] = 0;
+	}
+	data[0] = (uint8_t)n;
+	data[1] = 3;
+	return n;
+}
+static void
+handle_setup(void)
+{
+	sync_dma(SETUP, 8);
+	const uint8_t *s = (const uint8_t *)(u.dma + SETUP);
+	uint8_t *data = (uint8_t *)(u.dma + DATA);
+	unsigned value = s[2] | (s[3] << 8), index = s[4] | (s[5] << 8);
+	unsigned length = s[6] | (s[7] << 8), n = 0;
+	int kind = lqusb_request(s[0], s[1], (uint16_t)value, (uint16_t)index, (uint16_t)length);
+	u.data_in = (s[0] & 0x80) != 0;
+	u.set_line = false;
+	if (u.setups++ < 40) {
+		printf("LIUQIN USB: setup %02x %02x %04x %04x len%u\n", s[0], s[1], value, index, length);
+	}
+	switch (kind) {
+	case LQUSB_DESC:
+		switch (value >> 8) {
+		case 1:
+			if (value & 255) {
+				break;
+			}
+			memcpy(data, lqusb_device, sizeof(lqusb_device));
+			n = sizeof(lqusb_device);
+			break;
+		case 2:
+		case 7:
+			if (value & 255) {
+				break;
+			}
+			memcpy(data, lqusb_config, sizeof(lqusb_config));
+			n = sizeof(lqusb_config);
+			data[1] = (uint8_t)(value >> 8);
+			/* Configuration and other-speed configuration have opposite MPS. */
+			for (unsigned i = 0; i + 5 < n && data[i]; i += data[i]) {
+				if (data[i + 1] == 5 && (data[i + 3] & 3) == 2) {
+					unsigned m = (value >> 8) == 7 ? (u.mps == 512 ? 64 : 512) : u.mps;
+					data[i + 4] = (uint8_t)m;
+					data[i + 5] = (uint8_t)(m >> 8);
+				}
+			}
+			break;
+		case 3:
+			n = string_desc(value & 255, data);
+			break;
+		case 6:
+			if (!(value & 255)) {
+				memcpy(data, lqusb_qualifier, sizeof(lqusb_qualifier));
+				n = sizeof(lqusb_qualifier);
+			}
+			break;
+		default:
+			break;
+		}
+		if (!n) {
+			stall();
+			return;
+		}
+		break;
+	case LQUSB_ADDRESS:
+		wr(DCFG, (rd(DCFG) & ~(127u << 3)) | (value << 3));
+		break;
+	case LQUSB_CONFIG:
+		/* Reconfiguration while transfers are live is stopped, never recycled
+		 * before a controller reset drains stale completion events. */
+		if (!value && u.configured) {
+			fail("host deconfigured; reboot to reconnect");
+			return;
+		}
+		if (value) {
+			configure();
+		}
+		break;
+	case LQUSB_GET_CONFIG:
+		data[0] = u.configured ? 1 : 0;
+		n = 1;
+		break;
+	case LQUSB_STATUS:
+		data[0] = data[1] = 0;
+		n = 2;
+		break;
+	case LQUSB_INTERFACE:
+		break;
+	case LQUSB_GET_INTERFACE:
+		data[0] = 0;
+		n = 1;
+		break;
+	case LQUSB_SET_LINE:
+		u.set_line = true;
+		break;
+	case LQUSB_GET_LINE:
+		memcpy(data, u.coding, 7);
+		n = 7;
+		break;
+	case LQUSB_CONTROL:
+		if (u.configured) {
+			bool old = u.dtr;
+			u.dtr = (value & 1) != 0;
+			u.notify = true;
+			if (u.dtr && !old) {
+				printf("LIUQIN USB: console open; help/status/ping/replay (read only)\n");
+			}
+		}
+		break;
+	case LQUSB_BREAK:
+		break;
+	case LQUSB_CLEAR_HALT:
+		/* An active transfer cannot be made safe by CLEARSTALL alone. */
+		if (u.busy[(index & 15) * 2 + ((index >> 7) & 1)]) {
+			fail("clear-halt on active endpoint");
+			return;
+		}
+		(void)epcmd((index & 15) * 2 + ((index >> 7) & 1), CLEAR_STALL, 0, 0, 0);
+		break;
+	default:
+		stall();
+		return;
+	}
+	if (u.failed) {
+		return;
+	}
+	if (!length) {
+		u.phase = WAIT2;
+		return;
+	}
+	u.phase = DATA_PHASE;
+	if (u.data_in) {
+		transfer(1, DATA, n < length ? n : length, T_DATA);
+	} else if (u.set_line) {
+		transfer(0, DATA, 64, T_DATA);
+	} else {
+		stall();
+	}
+}
+static void
+command_line(void)
+{
+	u.command[u.command_n] = 0;
+	if (u.command_overflow) {
+		printf("LIUQIN DEBUG: command too long\n");
+	} else if (!strcmp(u.command, "ping")) {
+		printf("LIUQIN DEBUG: pong LIQDBG001\n");
+	} else if (!strcmp(u.command, "status")) {
+		printf("LIUQIN DEBUG: LIQDBG001 sid=%x events=%u tx=%llu rx=%llu log=%llu dropped=%llu\n",
+		    u.sid, u.events, u.tx_bytes, u.rx_bytes,
+		    liuqin_debug_total(), liuqin_debug_dropped());
+	} else if (!strcmp(u.command, "replay")) {
+		u.cursor = 0;
+		printf("LIUQIN DEBUG: replay retained RAM log\n");
+	} else if (u.command_n) {
+		printf("LIUQIN DEBUG: commands help status ping replay; queries only\n");
+	}
+	u.command_n = 0;
+	u.command_overflow = false;
+}
+static void
+receive_done(unsigned length)
+{
+	sync_dma(RX, RX_SIZE);
+	u.rx_bytes += length;
+	const uint8_t *p = (const uint8_t *)(u.dma + RX);
+	for (unsigned i = 0; i < length; i++) {
+		if (p[i] == '\r' || p[i] == '\n') {
+			command_line();
+		} else if (p[i] >= 32 && p[i] <= 126) {
+			if (u.command_n < (unsigned)sizeof(u.command) - 1) {
+				u.command[u.command_n++] = (char)p[i];
+			} else {
+				u.command_overflow = true;
+			}
+		}
+	}
+	receive_arm();
+}
+static void
+transmit(void)
+{
+	if (!u.configured || !u.dtr || u.failed) {
+		return;
+	}
+	if (u.notify && !u.busy[5]) {
+		const uint8_t msg[10] = { 0xa1, 0x20, 0, 0, 0, 0, 2, 0, 3, 0 };
+		memcpy((void *)(u.dma + NOTIFY), msg, sizeof(msg));
+		u.notify = false;
+		transfer(5, NOTIFY, sizeof(msg), T_NORMAL);
+	}
+	if (u.busy[3]) {
+		return;
+	}
+	unsigned n = liuqin_debug_copy(&u.cursor, (char *)(u.dma + TX), TX_SIZE);
+	/* The serial stream needs a short packet: never pad or invent bytes. */
+	if (n && !(n % u.mps)) {
+		n--;
+		u.cursor--;
+	}
+	if (n) {
+		transfer(3, TX, n, T_NORMAL);
+		u.tx_bytes += n;
+	}
+}
+static void
+event(uint32_t e)
+{
+	if (e & 1) {
+		if ((e & 0xfe) != 0) {
+			fail("unexpected device event format");
+			return;
+		}
+		unsigned type = (e >> 8) & 15;
+		if (type == 1) {
+			if (u.configured) {
+				stop_data();
+				fail("bus reset after configuration; reboot to reconnect");
+				return;
+			}
+			wr(DCFG, rd(DCFG) & ~(127u << 3));
+			printf("LIUQIN USB: bus reset\n");
+		} else if (type == 2) {
+			unsigned speed = rd(DSTS) & 7;
+			if (speed != 0 && speed != 1 && speed != 3) {
+				fail("unexpected non-USB2 speed");
+				return;
+			}
+			u.mps = speed == 0 ? 512 : 64;
+			(void)epcmd(0, SET_CONFIG, (64u << 3) | (2u << 30), (1u << 8) | (1u << 10), 0);
+			(void)epcmd(1, SET_CONFIG, (64u << 3) | (2u << 30), (1u << 8) | (1u << 10) | (1u << 25), 0);
+			printf("LIUQIN USB: connected speed=%u\n", speed);
+		} else if (!type && u.configured) {
+			fail("cable disconnect; reboot to reconnect");
+		} else if (type == 9 || type == 11) {
+			fail("controller/event overflow");
+		}
+		return;
+	}
+	unsigned ep = (e >> 1) & 31, type = (e >> 6) & 15, status = (e >> 12) & 15;
+	if (type == 1) {
+		int n = complete(ep);
+		if (n < 0) {
+			return;
+		}
+		if (status & 1) {
+			fail("USB transfer bus error");
+			return;
+		}
+		if (ep == 2) {
+			receive_done((unsigned)n);
+			return;
+		}
+		if (ep > 1) {
+			return;
+		}
+		switch (u.phase) {
+		case SETUP_PHASE:
+			if (ep != 0 || n != 8) {
+				fail("setup length");
+			} else {
+				handle_setup();
+			}
+			break;
+		case DATA_PHASE:
+			if (u.set_line) {
+				if (ep != 0 || n != 7) {
+					fail("line coding length");
+					break;
+				}
+				sync_dma(DATA, 64);
+				memcpy(u.coding, (void *)(u.dma + DATA), 7);
+			}
+			u.phase = WAIT3;
+			break;
+		case STATUS_PHASE:
+			setup_arm();
+			break;
+		default:
+			fail("control completion order");
+			break;
+		}
+	} else if (ep <= 1 && type == 3 && status == 2 && (u.phase == WAIT2 || u.phase == WAIT3)) {
+		unsigned direction = u.phase == WAIT2 ? 1 : (u.data_in ? 0 : 1);
+		if (ep != direction) {
+			fail("control status direction");
+			return;
+		}
+		unsigned kind = u.phase == WAIT3 ? T_STATUS3 : T_STATUS2;
+		u.phase = STATUS_PHASE;
+		transfer(ep, DATA, 0, kind);
+	}
+}
+static void
+usb_thread(void *arg __unused, wait_result_t result __unused)
+{
+	while (!u.failed) {
+		unsigned count = rd(GEVNTCOUNT) & 0xffff;
+		if (count > EVENT_SIZE || (count & 3)) {
+			fail("event ring size/alignment");
+			break;
+		}
+		if (count) {
+			sync_dma(EVENTS, EVENT_SIZE);
+			for (unsigned i = 0; i < count && !u.failed; i += 4) {
+				uint32_t e = *(volatile uint32_t *)(u.dma + u.pos);
+				u.pos = (u.pos + 4) % EVENT_SIZE;
+				u.events++;
+				event(e);
+			}
+			wr(GEVNTCOUNT, count);
+		}
+		transmit();
+		uint64_t deadline;
+		clock_interval_to_deadline(1, NSEC_PER_MSEC, &deadline);
+		(void)assert_wait_deadline(&u.sleep_channel, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+	wr(DEVTEN, 0);
+	wr(DCTL, rd(DCTL) & ~RUN);
+	thread_terminate(current_thread());
+}
+static uint32_t
+lq_smmu_read(void *context, uint32_t offset)
+{
+	return read_reg((vm_offset_t)(uintptr_t)context, offset);
+}
+
+static void
+lq_smmu_write(void *context, uint32_t offset, uint32_t value)
+{
+	*(volatile uint32_t *)((vm_offset_t)(uintptr_t)context + offset) = value;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void
+lq_smmu_barrier(void *context __unused)
+{
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+/* Modes: 0 skips SMMU, 1 accepts an existing identity route, 2 installs a
+ * translation-off context when SID0 has no route, and 3 plans without writing.
+ * All register changes and rollback run under the UFS/USB shared SMMU lock. */
+static int
+smmu_route(unsigned mode)
+{
+	static const struct lqusb_smmu_ops ops = {
+		.read = lq_smmu_read,
+		.write = lq_smmu_write,
+		.barrier = lq_smmu_barrier,
+	};
+	struct lqusb_smmu_result plan;
+
+	if (!pong_smmu_lease_lock()) {
+		printf("LIUQIN USB: SMMU lock unavailable; controller untouched\n");
+		return 0;
+	}
+	plan = lqusb_smmu_apply(&ops, (void *)(uintptr_t)u.smmu, u.sid,
+	    SMMU_UFS_BANK, mode >= 2, mode == 3);
+	pong_smmu_lease_unlock();
+
+	printf("LIUQIN USB: SMMU live slot=%u bank=%u smr=%08x s2cr=%08x "
+	    "sctlr=%08x cbar=%08x cba2r=%08x\n",
+	    plan.slot, plan.bank, plan.smr, plan.s2cr, plan.sctlr,
+	    plan.cbar, plan.cba2r);
+	printf("LIUQIN USB: SMMU plan mode=%u slot=%u bank=%u groups=%u banks=%u "
+	    "pages=%u reserved-bank=%u\n", mode, plan.slot, plan.bank,
+	    plan.groups, plan.banks, plan.pages, SMMU_UFS_BANK);
+
+	if (plan.status == LQUSB_SMMU_READY) {
+		printf("LIUQIN USB: SMMU identity context ready slot=%u bank=%u "
+		    "smr=%08x s2cr=%08x (%s)\n", plan.slot, plan.bank,
+		    plan.smr, plan.s2cr, plan.reason);
+		return 1;
+	}
+	if (plan.status == LQUSB_SMMU_REUSED) {
+		printf("LIUQIN USB: SMMU identity context reused slot=%u bank=%u "
+		    "smr=%08x s2cr=%08x (%s)\n", plan.slot, plan.bank,
+		    plan.smr, plan.s2cr, plan.reason);
+		return 1;
+	}
+	if (plan.status == LQUSB_SMMU_DRY_RUN) {
+		printf("LIUQIN USB: SMMU bypass dry run selected slot=%u bank=%u; "
+		    "controller untouched\n", plan.slot, plan.bank);
+		return 2;
+	}
+	printf("LIUQIN USB: SMMU route refused: %s (status=%d)\n",
+	    plan.reason, plan.status);
+	return 0;
+}
+
+static bool lq_number(const char **text, uint64_t *value);
+
+void
+liuqin_fb_marker_boot(void)
+{
+	{
+		char spec[64];
+		uint64_t base = 0xb8000000ULL, width = 1800, height = 2880, stride = 7200;
+		if (PE_parse_boot_argn("fb", spec, sizeof(spec))) {
+			const char *text = spec;
+			uint64_t part[4];
+			unsigned n = 0;
+			while (n < 4 && lq_number(&text, &part[n])) {
+				n++;
+				if (*text != ',') {
+					break;
+				}
+				text++;
+			}
+			if (n == 4) {
+				base = part[0];
+				width = part[1];
+				height = part[2];
+				stride = part[3];
+			}
+		}
+		/* liuqin: do not bind here. ml_io_map needs kernel_map, and its
+		 * allocations wait for the pageout thread, which starts only at the end of
+		 * kernel_bootstrap_thread -- calling this from bsd_init deadlocks. The
+		 * console already paints through the identity mapping of the boot tables,
+		 * which is the same framebuffer. */
+		(void)base;
+		(void)width;
+		(void)height;
+		(void)stride;
+		liuqin_fb_band(0, 0xff00ffffu);
+		{ extern void liuqin_fb_bigband(unsigned, unsigned, uint32_t);
+		  liuqin_fb_bigband(2400, 240, 0xffff00ffu); }
+	}
+}
+
+static bool
+lq_number(const char **text, uint64_t *value)
+{
+	const char *s = *text;
+	uint64_t v = 0;
+	unsigned base = 10, digits = 0;
+
+	while (*s == ' ') {
+		s++;
+	}
+	if (s[0] == '0' && (s[1] == 'x' || s[1] == 'X')) {
+		base = 16;
+		s += 2;
+	}
+	for (;; s++) {
+		unsigned d;
+		if (*s >= '0' && *s <= '9') {
+			d = (unsigned)(*s - '0');
+		} else if (base == 16 && *s >= 'a' && *s <= 'f') {
+			d = (unsigned)(*s - 'a') + 10;
+		} else if (base == 16 && *s >= 'A' && *s <= 'F') {
+			d = (unsigned)(*s - 'A') + 10;
+		} else {
+			break;
+		}
+		v = v * base + d;
+		if (++digits > 16) {
+			return false;
+		}
+	}
+	if (!digits) {
+		return false;
+	}
+	*text = s;
+	*value = v;
+	return true;
+}
+static void
+liuqin_usb_debug_init(void)
+{
+	u.mps = 512;
+	u.coding[0] = 0;
+	u.coding[1] = 0xc2;
+	u.coding[2] = 1;
+	u.coding[6] = 8;
+	u.sid = USB_SID_DEF;
+	PE_parse_boot_argn("liuqin_usb_sid", &u.sid, sizeof(u.sid));
+	u.dma_lo = DMA_LO_DEF;
+	u.dma_hi = DMA_HI_DEF;
+	{
+		char win[64];
+		if (PE_parse_boot_argn("liuqin_usb_dma", win, sizeof(win))) {
+			char *sep = strchr(win, ',');
+			if (sep) {
+				*sep = 0;
+				u.dma_lo = strtouq(win, NULL, 0);
+				u.dma_hi = strtouq(sep + 1, NULL, 0);
+			}
+		}
+	}
+	printf("LIUQIN USB: CDC ACM debug port, RAM log and read-only commands\n");
+
+	/* Guard 1: the USB30_PRIM power domain and its three branch clocks must
+	 * already be running. This driver never programs GCC. */
+	vm_offset_t gcc = liuqin_io_map(GCC_PA, 0x1000);
+	if (!gcc) {
+		return;
+	}
+	uint32_t gdsc = read_reg(gcc, GCC_GDSC_OFF), master = read_reg(gcc, GCC_MASTER_OFF);
+	uint32_t cfg = read_reg(gcc, GCC_CFG_OFF), aggre = read_reg(gcc, GCC_AGGRE_OFF);
+	printf("LIUQIN USB: GCC gdsc=%08x master=%08x cfg=%08x aggre=%08x\n",
+	    gdsc, master, cfg, aggre);
+	if (!(gdsc & (1u << 31))) {
+		liuqin_fb_band(11, 0xffff0000u);
+		printf("LIUQIN USB: usb30_prim power domain off; controller untouched\n");
+		return;
+	}
+	if ((master | cfg | aggre) & (1u << 31)) {
+		liuqin_fb_band(12, 0xffff0000u);
+		printf("LIUQIN USB: USB clocks halted; controller untouched\n");
+		return;
+	}
+	liuqin_fb_band(1, 0xff00ff00u);
+
+	/* Guard 2: DWC3 identity and device mode, as left behind by ABL/UEFI. */
+	u.regs = liuqin_io_map(DWC3_PA, DWC3_SIZE);
+	u.smmu = liuqin_io_map(SMMU_PA, SMMU_SIZE);
+	if (!u.regs || !u.smmu) {
+		return;
+	}
+	uint32_t id = rd(0xc120), hw = rd(0xc140);
+	unsigned width = hw >> 24;
+	printf("LIUQIN USB: id=%08x hwparams0=%08x awidth=%u gctl=%08x dctl=%08x dsts=%08x\n",
+	    id, hw, width, rd(GCTL), rd(DCTL), rd(DSTS));
+	if ((id >> 16) != 0x5533 && (id >> 16) != 0x3331) {
+		liuqin_fb_band(13, 0xffff0000u);
+		printf("LIUQIN USB: unknown controller; controller untouched\n");
+		return;
+	}
+	if (((rd(GCTL) >> 12) & 3) != 2) {
+		liuqin_fb_band(14, 0xffff0000u);
+		printf("LIUQIN USB: controller not in device mode; controller untouched\n");
+		return;
+	}
+	liuqin_fb_band(2, 0xff0000ffu);
+
+	/* Guard 3: exact SID0 identity route, or one safe translation-off
+	 * context created under the shared SMMU lock. Mode 3 is read-only. */
+	{
+		unsigned smmu_mode = 1;
+		int route;
+		PE_parse_boot_argn("liuqin_usb_smmu", &smmu_mode, sizeof(smmu_mode));
+		if (smmu_mode > 3) {
+			printf("LIUQIN USB: invalid liuqin_usb_smmu=%u; controller untouched\n",
+			    smmu_mode);
+			return;
+		}
+		if (smmu_mode) {
+			route = smmu_route(smmu_mode);
+			if (route != 1) {
+				liuqin_fb_band(15, 0xffff0000u);
+				return;
+			}
+		} else {
+			printf("LIUQIN USB: SMMU route check skipped by liuqin_usb_smmu=0\n");
+		}
+	}
+	liuqin_fb_band(3, 0xffffff00u);
+
+	/* Guard 4: one permanent 16 KiB contiguous DMA block inside the window. */
+	if (kmem_alloc_contig(kernel_map, &u.dma, DMA_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		liuqin_fb_band(16, 0xffff0000u);
+		printf("LIUQIN USB: DMA allocation failed\n");
+		return;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)u.dma);
+	if (!pn) {
+		return;
+	}
+	u.pa = ptoa_64(pn);
+	if (!lqusb_dma_allowed(u.pa, DMA_SIZE, width, u.dma_lo, u.dma_hi)) {
+		liuqin_fb_band(17, 0xffff0000u);
+		printf("LIUQIN USB: DMA %llx refused by window %llx-%llx width %u\n",
+		    u.pa, u.dma_lo, u.dma_hi, width);
+		return;
+	}
+	for (unsigned off = 0; off < DMA_SIZE; off += PAGE_SIZE) {
+		ppnum_t page = pmap_find_phys(kernel_pmap, (addr64_t)(u.dma + off));
+		if (!page || ptoa_64(page) != u.pa + off) {
+			liuqin_fb_band(18, 0xffff0000u);
+			printf("LIUQIN USB: DMA not contiguous at %x\n", off);
+			return;
+		}
+	}
+
+	liuqin_fb_band(4, 0xffffffffu);
+	vm_offset_t qs = liuqin_io_map(QSCRATCH_PA, 0x100);
+	if (!qs) {
+		return;
+	}
+	/* Stop any old device DMA first: the soft reset must finish before the
+	 * descriptors are replaced. PHY and global bus settings stay as ABL left
+	 * them. */
+	wr(DEVTEN, 0);
+	wr(DCTL, rd(DCTL) & ~RUN);
+	unsigned i;
+	for (i = 0; i < 500 && !(rd(DSTS) & HALTED); i++) {
+		delay(1000);
+	}
+	if (!(rd(DSTS) & HALTED)) {
+		fail("controller halt timeout");
+		return;
+	}
+	wr(DCTL, RESET);
+	for (i = 0; i < 500 && (rd(DCTL) & RESET); i++) {
+		delay(1000);
+	}
+	if (rd(DCTL) & RESET) {
+		fail("controller reset timeout");
+		return;
+	}
+	sync_dma(0, DMA_SIZE);
+	wr(GEVNTADRLO, (uint32_t)u.pa);
+	wr(GEVNTADRHI, (uint32_t)(u.pa >> 32));
+	if (rd(GEVNTADRHI) != (uint32_t)(u.pa >> 32)) {
+		fail("event address readback");
+		return;
+	}
+	wr(GEVNTSIZ, (1u << 31) | EVENT_SIZE);
+	wr(GEVNTCOUNT, rd(GEVNTCOUNT) & 0xffff);
+	wr(DCFG, rd(DCFG) & ~(7u | (127u << 3)));   /* high speed only */
+	if (epcmd(0, START_CONFIG, 0, 0, 0) ||
+	    epcmd(0, SET_CONFIG, 64u << 3, (1u << 8) | (1u << 10), 0) ||
+	    epcmd(0, SET_RESOURCE, 1, 0, 0) ||
+	    epcmd(1, SET_CONFIG, 64u << 3, (1u << 8) | (1u << 10) | (1u << 25), 0) ||
+	    epcmd(1, SET_RESOURCE, 1, 0, 0)) {
+		return;
+	}
+	wr(DALEPENA, 3);
+	setup_arm();
+	if (u.failed) {
+		return;
+	}
+	/* Qualcomm wrapper VBUS-valid override, the same bits the SM8450 family
+	 * glue writes: HS UTMI VBUS_VALID + SW_SESSVLD_SEL, SS LANE0 power. */
+	uint32_t hs = read_reg(qs, 0x10), ss = read_reg(qs, 0x30);
+	*(volatile uint32_t *)(qs + 0x10) = hs | (1u << 20) | (1u << 28);
+	*(volatile uint32_t *)(qs + 0x30) = ss | (1u << 24);
+	__asm__ volatile("dsb sy" ::: "memory");
+	wr(DEVTEN, 7 | (1u << 9) | (1u << 11));
+	wr(DCTL, rd(DCTL) | RUN);
+	for (i = 0; i < 500 && (rd(DSTS) & HALTED); i++) {
+		delay(1000);
+	}
+	if (rd(DSTS) & HALTED) {
+		fail("controller run timeout");
+		return;
+	}
+	thread_t thread;
+	if (kernel_thread_start(usb_thread, NULL, &thread) != KERN_SUCCESS) {
+		fail("poll thread creation");
+		wr(DCTL, rd(DCTL) & ~RUN);
+		return;
+	}
+	thread_deallocate(thread);
+	liuqin_fb_band(5, 0xffff00ffu);
+	printf("LIUQIN USB: running; DMA=%llx; Windows serial LIQDBG001; awaiting enumeration\n", u.pa);
+}
+
+static void
+liuqin_usb_debug_worker(void *arg __unused, wait_result_t result __unused)
+{
+	liuqin_usb_debug_init();
+	thread_terminate(current_thread());
+}
+
+void
+liuqin_usb_debug_start(void)
+{
+	static bool attempted;
+	int enabled = 0;
+
+	PE_parse_boot_argn("liuqin_usb", &enabled, sizeof(enabled));
+	if (enabled != 1) {
+		liuqin_fb_band(6, 0xffff8000u);
+		return;
+	}
+	if (attempted) {
+		return;
+	}
+	attempted = true;
+
+	thread_t thread;
+	if (kernel_thread_start(liuqin_usb_debug_worker, NULL, &thread) != KERN_SUCCESS) {
+		printf("LIUQIN USB: start worker thread failed; controller untouched\n");
+		return;
+	}
+	thread_deallocate(thread);
+}
diff --git a/bsd/dev/liuqin_usb_protocol.h b/bsd/dev/liuqin_usb_protocol.h
new file mode 100644
index 0000000..26cca0f
--- /dev/null
+++ b/bsd/dev/liuqin_usb_protocol.h
@@ -0,0 +1,75 @@
+/* CDC ACM descriptors and request whitelist for the liuqin USB debug port.
+ * Lab VID/PID 1209:0002, synthetic serial LIQDBG001. Ported from vermeer.
+ */
+#ifndef LIUQIN_USB_PROTOCOL_H
+#define LIUQIN_USB_PROTOCOL_H
+#ifdef LIUQIN_HOST_TEST
+#include <stdint.h>
+#else
+#include <sys/types.h>
+#endif
+static const uint8_t lqusb_device[18] = {
+	18, 1, 0x00, 0x02, 2, 2, 1, 64, 0x09, 0x12, 0x02, 0x00, 0, 4, 1, 2, 3, 1
+};
+static const uint8_t lqusb_config[67] = {
+	9, 2, 67, 0, 2, 1, 0, 0x80, 250,
+	9, 4, 0, 0, 1, 2, 2, 1, 0,
+	5, 0x24, 0, 0x10, 1,
+	5, 0x24, 1, 0, 1,
+	4, 0x24, 2, 2,
+	5, 0x24, 6, 0, 1,
+	7, 5, 0x82, 3, 16, 0, 9,
+	9, 4, 1, 0, 2, 0x0a, 0, 0, 0,
+	7, 5, 0x01, 2, 0, 2, 0,
+	7, 5, 0x81, 2, 0, 2, 0
+};
+static const uint8_t lqusb_qualifier[10] = { 10, 6, 0, 2, 2, 2, 1, 64, 1, 0 };
+
+/* The DMA block must be one aligned contiguous run inside the caller supplied
+ * window, and the controller must be able to address all of it. */
+static inline int lqusb_dma_allowed(uint64_t pa, unsigned size, unsigned bits,
+    uint64_t lo, uint64_t hi)
+{
+	if (size != 0x4000 || (pa & 0x3fff)) return 0;
+	if (!lo || hi <= lo || pa < lo || pa >= hi) return 0;
+	if (size > hi - pa) return 0;
+	if (bits < 32 || bits > 64) return 0;
+	return bits == 64 || pa + size - 1 < (1ULL << bits);
+}
+
+/* Exactly one nonsecure stream must match the USB stream ID and its route must
+ * be identity (or bypass): the port never creates or weakens a mapping. */
+static inline int lqusb_stream_match(uint32_t smr, uint32_t sid)
+{
+	return (smr >> 31) && !((smr ^ sid) & ~((smr >> 16) & 0x7fff) & 0xffff);
+}
+static inline int lqusb_route_identity(uint32_t s2cr, uint32_t cbar, uint32_t sctlr)
+{
+	unsigned type = (s2cr >> 16) & 3;
+	return type == 1 || (type == 0 && ((cbar >> 16) & 3) == 1 && !(sctlr & 1));
+}
+
+/* Recognised request kinds only; malformed class OUT lengths stall. */
+enum {
+	LQUSB_BAD, LQUSB_DESC, LQUSB_ADDRESS, LQUSB_CONFIG, LQUSB_GET_CONFIG,
+	LQUSB_STATUS, LQUSB_INTERFACE, LQUSB_GET_INTERFACE, LQUSB_SET_LINE,
+	LQUSB_GET_LINE, LQUSB_CONTROL, LQUSB_BREAK, LQUSB_CLEAR_HALT
+};
+static inline int lqusb_request(uint8_t type, uint8_t req, uint16_t value,
+    uint16_t index, uint16_t len)
+{
+	if (type == 0x80 && req == 6 && ((value >> 8) >= 1 && (value >> 8) <= 7)) return LQUSB_DESC;
+	if (type == 0 && req == 5 && !index && !len && value < 128) return LQUSB_ADDRESS;
+	if (type == 0 && req == 9 && !index && !len && value <= 1) return LQUSB_CONFIG;
+	if (type == 0x80 && req == 8 && !value && !index && len == 1) return LQUSB_GET_CONFIG;
+	if ((type == 0x80 || type == 0x81 || type == 0x82) && req == 0 && !value && len == 2) return LQUSB_STATUS;
+	if (type == 1 && req == 11 && index <= 1 && !value && !len) return LQUSB_INTERFACE;
+	if (type == 0x81 && req == 10 && index <= 1 && !value && len == 1) return LQUSB_GET_INTERFACE;
+	if (type == 0x21 && req == 0x20 && !index && !value && len == 7) return LQUSB_SET_LINE;
+	if (type == 0xa1 && req == 0x21 && !index && !value && len == 7) return LQUSB_GET_LINE;
+	if (type == 0x21 && req == 0x22 && !index && !len && !(value & ~3)) return LQUSB_CONTROL;
+	if (type == 0x21 && req == 0x23 && !index && !len) return LQUSB_BREAK;
+	if (type == 2 && req == 1 && !value && !len && (index == 1 || index == 0x81 || index == 0x82)) return LQUSB_CLEAR_HALT;
+	return LQUSB_BAD;
+}
+#endif
diff --git a/bsd/dev/liuqin_usb_smmu.h b/bsd/dev/liuqin_usb_smmu.h
new file mode 100644
index 0000000..bef46db
--- /dev/null
+++ b/bsd/dev/liuqin_usb_smmu.h
@@ -0,0 +1,336 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* ARM SMMUv2 stream planning for the LIUQIN debug controller.
+ *
+ * The controller already performs cache maintenance, so a translation-off
+ * context is sufficient. The planner never replaces a live stream mapping and
+ * reserves the UFS bank. All stream and context state is verified after each
+ * publish, and a failed publish is rolled back under the shared SMMU lock.
+ */
+#ifndef LIUQIN_USB_SMMU_H
+#define LIUQIN_USB_SMMU_H
+
+#ifdef LIUQIN_HOST_TEST
+#include <stdint.h>
+#else
+#include <sys/types.h>
+#endif
+
+#define LQUSB_SMMU_WINDOW          0x000d0000U
+#define LQUSB_SMMU_CBAR_BYPASS     0x00010000U
+#define LQUSB_SMMU_CBA2R_AARCH64   0x00000001U
+#define LQUSB_SMMU_SMR_VALID       0x80000000U
+#define LQUSB_SMMU_NONE            0xffffffffU
+
+enum lqusb_smmu_status {
+	LQUSB_SMMU_READY = 0,
+	LQUSB_SMMU_REUSED,
+	LQUSB_SMMU_DRY_RUN,
+	LQUSB_SMMU_BAD_GEOMETRY = -1,
+	LQUSB_SMMU_NOT_FOUND = -2,
+	LQUSB_SMMU_CONFLICT = -3,
+	LQUSB_SMMU_NO_SLOT = -4,
+	LQUSB_SMMU_NO_BANK = -5,
+	LQUSB_SMMU_READBACK = -6,
+	LQUSB_SMMU_ROLLBACK = -7
+};
+
+struct lqusb_smmu_ops {
+	uint32_t (*read)(void *context, uint32_t offset);
+	void (*write)(void *context, uint32_t offset, uint32_t value);
+	void (*barrier)(void *context);
+};
+
+struct lqusb_smmu_result {
+	int status;
+	const char *reason;
+	unsigned groups;
+	unsigned banks;
+	unsigned pages;
+	unsigned slot;
+	unsigned bank;
+	unsigned reused;
+	uint32_t smr;
+	uint32_t s2cr;
+	uint32_t sctlr;
+	uint32_t cbar;
+	uint32_t cba2r;
+};
+
+static inline int
+lqusb_smmu_geometry(uint32_t idr0, uint32_t idr1, uint32_t idr2,
+    unsigned *groups, unsigned *banks, unsigned *pages)
+{
+	unsigned g = idr0 & 0xffU;
+	unsigned b = idr1 & 0xffU;
+	unsigned p;
+
+	if (!(idr0 & (1U << 30)) || !(idr2 & (1U << 12))) return 0;
+	if ((idr1 >> 31) || !g || g > 128 || b < 2 || b > 128) return 0;
+	p = 1U << (((idr1 >> 28) & 7U) + 1);
+	if (p > 128 || (p + b) * 4096U > LQUSB_SMMU_WINDOW) return 0;
+	*groups = g;
+	*banks = b;
+	*pages = p;
+	return 1;
+}
+
+static inline uint32_t
+lqusb_smmu_context_offset(unsigned pages, unsigned bank)
+{
+	return (pages + bank) * 4096U;
+}
+
+static inline int
+lqusb_smmu_stream_match(uint32_t smr, uint32_t sid)
+{
+	uint32_t mask = (smr >> 16) & 0x7fffU;
+	return (smr & LQUSB_SMMU_SMR_VALID) &&
+	    (((smr ^ sid) & 0xffffU & ~mask) == 0);
+}
+
+static inline int
+lqusb_smmu_exact_stream(uint32_t smr, uint32_t sid)
+{
+	return (smr & LQUSB_SMMU_SMR_VALID) && !((smr >> 16) & 0x7fffU) &&
+	    (smr & 0xffffU) == sid;
+}
+
+static inline int
+lqusb_smmu_route_identity(uint32_t s2cr, unsigned banks,
+    uint32_t cbar, uint32_t sctlr)
+{
+	unsigned type = (s2cr >> 16) & 3U;
+	unsigned bank = s2cr & 0xffU;
+
+	if (type == 1) return 1;
+	if (type != 0 || bank >= banks) return 0;
+	return ((cbar >> 16) & 3U) == 1 && !(sctlr & 1U);
+}
+
+static inline void
+lqusb_smmu_restore(const struct lqusb_smmu_ops *ops, void *context,
+    const struct lqusb_smmu_result *saved, uint32_t slot_smr,
+    uint32_t slot_s2cr)
+{
+	uint32_t cb = lqusb_smmu_context_offset(saved->pages, saved->bank);
+
+	/* Quiesce the stream before removing its context configuration. */
+	ops->write(context, 0x800U + 4U * saved->slot, slot_smr);
+	if (ops->barrier) ops->barrier(context);
+	ops->write(context, 0xc00U + 4U * saved->slot, slot_s2cr);
+	ops->write(context, 0x1800U + 4U * saved->bank, saved->cba2r);
+	ops->write(context, 0x1000U + 4U * saved->bank, saved->cbar);
+	ops->write(context, cb, saved->sctlr);
+	if (ops->barrier) ops->barrier(context);
+}
+
+static inline int
+lqusb_smmu_restored(const struct lqusb_smmu_ops *ops, void *context,
+    const struct lqusb_smmu_result *saved, uint32_t slot_smr,
+    uint32_t slot_s2cr)
+{
+	uint32_t cb = lqusb_smmu_context_offset(saved->pages, saved->bank);
+
+	return ops->read(context, 0x800U + 4U * saved->slot) == slot_smr &&
+	    ops->read(context, 0xc00U + 4U * saved->slot) == slot_s2cr &&
+	    ops->read(context, 0x1800U + 4U * saved->bank) == saved->cba2r &&
+	    ops->read(context, 0x1000U + 4U * saved->bank) == saved->cbar &&
+	    ops->read(context, cb) == saved->sctlr;
+}
+
+/* mode is interpreted by the caller. create permits installing one new exact
+ * stream. dry_run performs the complete planner scan and selects a bank without
+ * touching any SMMU register. The caller holds pong_smmu_lease_lock(). */
+static inline struct lqusb_smmu_result
+lqusb_smmu_apply(const struct lqusb_smmu_ops *ops, void *context, uint32_t sid,
+    unsigned reserved_bank, int create, int dry_run)
+{
+	struct lqusb_smmu_result p;
+	uint64_t used[2] = { 0, 0 };
+	uint32_t idr0, idr1, idr2;
+	unsigned matches = 0;
+	unsigned i;
+
+	p.status = LQUSB_SMMU_BAD_GEOMETRY;
+	p.reason = "unsupported SMMU geometry";
+	p.groups = p.banks = p.pages = 0;
+	p.slot = p.bank = LQUSB_SMMU_NONE;
+	p.reused = 0;
+	p.smr = p.s2cr = 0;
+	p.sctlr = 1;
+	p.cbar = p.cba2r = 0;
+	if (!ops || !ops->read || !ops->write || sid > 0xffffU) return p;
+
+	idr0 = ops->read(context, 0x20);
+	idr1 = ops->read(context, 0x24);
+	idr2 = ops->read(context, 0x28);
+	if (!lqusb_smmu_geometry(idr0, idr1, idr2, &p.groups, &p.banks, &p.pages))
+		return p;
+
+	for (i = 0; i < p.groups; i++) {
+		uint32_t smr = ops->read(context, 0x800U + 4U * i);
+		uint32_t s2cr;
+		unsigned type, mapped;
+
+		if (!(smr & LQUSB_SMMU_SMR_VALID)) {
+			if (p.slot == LQUSB_SMMU_NONE) p.slot = i;
+			continue;
+		}
+		s2cr = ops->read(context, 0xc00U + 4U * i);
+		if (lqusb_smmu_stream_match(smr, sid)) {
+			matches++;
+			p.slot = i;
+			p.smr = smr;
+			p.s2cr = s2cr;
+		}
+		type = (s2cr >> 16) & 3U;
+		mapped = s2cr & 0xffU;
+		if (type == 0 && mapped < p.banks)
+			used[mapped / 64] |= 1ULL << (mapped % 64);
+	}
+
+	if (matches > 1) {
+		p.status = LQUSB_SMMU_CONFLICT;
+		p.reason = "multiple streams match USB SID";
+		return p;
+	}
+	if (matches == 1) {
+		unsigned bank = p.s2cr & 0xffU;
+		uint32_t route_type = (p.s2cr >> 16) & 3U;
+
+		p.bank = bank;
+		if (!lqusb_smmu_exact_stream(p.smr, sid)) {
+			p.status = LQUSB_SMMU_CONFLICT;
+			p.reason = "masked USB stream already installed";
+			return p;
+		}
+		if (route_type == 1) {
+			p.status = LQUSB_SMMU_REUSED;
+			p.reason = "existing bypass route reused";
+			p.reused = 1;
+			return p;
+		}
+		if (route_type != 0 || bank >= p.banks) {
+			p.status = LQUSB_SMMU_CONFLICT;
+			p.reason = "existing USB route is not reversible identity";
+			return p;
+		}
+		p.cbar = ops->read(context, 0x1000U + 4U * bank);
+		p.cba2r = ops->read(context, 0x1800U + 4U * bank);
+		p.sctlr = ops->read(context, lqusb_smmu_context_offset(p.pages, bank));
+		if (!lqusb_smmu_route_identity(p.s2cr, p.banks, p.cbar, p.sctlr)) {
+			p.status = LQUSB_SMMU_CONFLICT;
+			p.reason = "existing USB context translation is enabled";
+			return p;
+		}
+		p.status = LQUSB_SMMU_REUSED;
+		p.reason = "existing identity context reused";
+		p.reused = 1;
+		return p;
+	}
+
+	if (!create) {
+		p.status = LQUSB_SMMU_NOT_FOUND;
+		p.reason = "no identity route for USB SID";
+		return p;
+	}
+	if (p.slot == LQUSB_SMMU_NONE) {
+		p.status = LQUSB_SMMU_NO_SLOT;
+		p.reason = "no free stream-match group";
+		return p;
+	}
+
+	/* Bank 0 is reserved by this platform. Bank 74 is the live UFS context.
+	 * Walk downward so a newly allotted bank stays close to the firmware range
+	 * while never replacing a translation used by another stream. */
+	for (i = p.banks - 1; i > 0; i--) {
+		uint32_t cbar, cba2r, sctlr;
+
+		if (i == reserved_bank) continue;
+		if ((used[i / 64] >> (i % 64)) & 1ULL) continue;
+		sctlr = ops->read(context, lqusb_smmu_context_offset(p.pages, i));
+		if (sctlr & 1U) continue;
+		cbar = ops->read(context, 0x1000U + 4U * i);
+		if (((cbar >> 16) & 3U) > 1U) continue;
+		cba2r = ops->read(context, 0x1800U + 4U * i);
+		p.bank = i;
+		p.sctlr = sctlr;
+		p.cbar = cbar;
+		p.cba2r = cba2r;
+		break;
+	}
+	if (p.bank == LQUSB_SMMU_NONE) {
+		p.status = LQUSB_SMMU_NO_BANK;
+		p.reason = "no unused bypass context bank";
+		return p;
+	}
+
+	if (dry_run) {
+		p.status = LQUSB_SMMU_DRY_RUN;
+		p.reason = "SMMU bypass plan complete";
+		return p;
+	}
+
+	{
+		uint32_t old_cbar = p.cbar, old_cba2r = p.cba2r;
+		uint32_t old_sctlr = p.sctlr;
+		uint32_t old_smr = ops->read(context, 0x800U + 4U * p.slot);
+		uint32_t old_s2cr = ops->read(context, 0xc00U + 4U * p.slot);
+		uint32_t cb = lqusb_smmu_context_offset(p.pages, p.bank);
+		int failed = 0;
+
+		ops->write(context, cb, 0);
+		ops->write(context, 0x1800U + 4U * p.bank, LQUSB_SMMU_CBA2R_AARCH64);
+		ops->write(context, 0x1000U + 4U * p.bank, LQUSB_SMMU_CBAR_BYPASS);
+		if (ops->barrier) ops->barrier(context);
+		if (ops->read(context, cb) != 0 ||
+		    ops->read(context, 0x1800U + 4U * p.bank) != LQUSB_SMMU_CBA2R_AARCH64 ||
+		    ops->read(context, 0x1000U + 4U * p.bank) != LQUSB_SMMU_CBAR_BYPASS) {
+			p.status = LQUSB_SMMU_READBACK;
+			p.reason = "SMMU context readback failed";
+			failed = 1;
+		}
+
+		if (!failed) {
+			ops->write(context, 0xc00U + 4U * p.slot, p.bank);
+			if (ops->barrier) ops->barrier(context);
+			if (ops->read(context, 0xc00U + 4U * p.slot) != p.bank) {
+				p.status = LQUSB_SMMU_READBACK;
+				p.reason = "SMMU S2CR readback failed";
+				failed = 1;
+			}
+		}
+		if (!failed) {
+			p.smr = LQUSB_SMMU_SMR_VALID | sid;
+			ops->write(context, 0x800U + 4U * p.slot, p.smr);
+			if (ops->barrier) ops->barrier(context);
+			if (ops->read(context, 0x800U + 4U * p.slot) != p.smr) {
+				p.status = LQUSB_SMMU_READBACK;
+				p.reason = "SMMU SMR readback failed";
+				failed = 1;
+			}
+		}
+
+		if (failed) {
+			p.cbar = old_cbar;
+			p.cba2r = old_cba2r;
+			p.sctlr = old_sctlr;
+			lqusb_smmu_restore(ops, context, &p, old_smr, old_s2cr);
+			if (!lqusb_smmu_restored(ops, context, &p, old_smr, old_s2cr)) {
+				p.status = LQUSB_SMMU_ROLLBACK;
+				p.reason = "SMMU publish readback and rollback failed";
+			}
+			return p;
+		}
+		p.smr = LQUSB_SMMU_SMR_VALID | sid;
+		p.s2cr = p.bank;
+		p.cbar = LQUSB_SMMU_CBAR_BYPASS;
+		p.cba2r = LQUSB_SMMU_CBA2R_AARCH64;
+		p.sctlr = 0;
+		p.status = LQUSB_SMMU_READY;
+		p.reason = "bypass context installed";
+	}
+	return p;
+}
+
+#endif

+/* Console mirror for the liuqin USB debug port.
+ * Best effort: any context, never waits, never touches storage.
+ */
+#include <sys/types.h>
+#include <sys/systm.h>
+#include <machine/atomic.h>
+#include <mach/vm_types.h>
+#include "liuqin_log_ring.h"
+
+static struct lq_ring log_ring;
+static uint32_t _Atomic log_lock;
+static uint64_t _Atomic dropped;
+
+void liuqin_debug_append(const char *data, int size);
+void liuqin_debug_putc(char c);
+void liuqin_debug_puts(const char *s);
+void liuqin_fb_putc(char c);
+void liuqin_stage(unsigned stage);
+unsigned liuqin_debug_copy(uint64_t *pos, char *out, unsigned max);
+uint64_t liuqin_debug_total(void);
+uint64_t liuqin_debug_dropped(void);
+
+void
+liuqin_debug_append(const char *data, int size)
+{
+	if (size <= 0) {
+		return;
+	}
+	if (!os_atomic_cmpxchg(&log_lock, 0, 1, acquire)) {
+		os_atomic_add(&dropped, (uint64_t)size, relaxed);
+		return;
+	}
+	lq_append(&log_ring, data, (unsigned)size);
+	os_atomic_store(&log_lock, 0, release);
+}
+
+void
+liuqin_debug_putc(char c)
+{
+	/* both the pe_kprintf hook and _cnputc feed this, so every character */
+	/* arrives twice and the panel would show 'UUnnddeeffiinneedd'. Drop the */
+	/* second copy of an immediate repeat. */
+	static char last;
+	if (c == last) {
+		last = 0;
+		return;
+	}
+	last = c;
+	liuqin_debug_append(&c, 1);
+	liuqin_fb_putc(c);
+}
+/* Same path without the de-duplication: used for hex dumps where two equal
+ * digits in a row are meaningful. */
+void
+liuqin_debug_puts(const char *s)
+{
+	int n = 0;
+
+	while (s[n] != 0) {
+		n++;
+	}
+	liuqin_debug_append(s, n);
+	for (int i = 0; i < n; i++) {
+		liuqin_fb_putc(s[i]);
+	}
+}
+
+unsigned
+liuqin_debug_copy(uint64_t *pos, char *out, unsigned max)
+{
+	if (!max) {
+		return 0;
+	}
+	if (!os_atomic_cmpxchg(&log_lock, 0, 1, acquire)) {
+		return 0;
+	}
+	unsigned n = lq_copy(&log_ring, pos, out, max);
+	os_atomic_store(&log_lock, 0, release);
+	return n;
+}
+
+uint64_t
+liuqin_debug_total(void)
+{
+	return log_ring.total;
+}
+
+uint64_t
+liuqin_debug_dropped(void)
+{
+	return os_atomic_load(&dropped, relaxed);
+}
+
+/* Screen markers: before the USB transport is up the panel is the only output
+ * channel. These paint bands at the top of the UEFI splash framebuffer, so one
+ * photograph says how far the kernel got. Best effort: one static mapping, no
+ * locks, no allocation; a failed map simply disables the markers.
+ */
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+/* Before pmap exists the panel is reachable through the identity mapping the */
+/* boot tables provide, so early kprintf and panic text already land on it. */
+#define LQ_FB_EARLY ((uint32_t *)(vm_offset_t)0xb8000000ULL)
+static uint32_t *lq_fb = NULL;
+static uint32_t *lq_fb_late;
+static uint32_t lq_fb_width = 1800, lq_fb_stride_px = 1800;
+
+void liuqin_fb_bind(uint64_t, uint32_t, uint32_t, uint32_t);
+void liuqin_fb_band(unsigned, uint32_t);
+
+void
+liuqin_fb_bind(uint64_t base, uint32_t width, uint32_t height, uint32_t stride_bytes)
+{
+	uint64_t rows = height < 1600 ? height : 1600;
+
+	if (lq_fb != LQ_FB_EARLY || !base || !width || !height || stride_bytes < 4) {
+		return;
+	}
+	vm_offset_t map = ml_io_map((vm_offset_t)base, (vm_size_t)(rows * stride_bytes));
+	if (!map) {
+		return;
+	}
+	lq_fb = (uint32_t *)map;
+	lq_fb_width = width;
+	lq_fb_stride_px = stride_bytes / 4;
+}
+
+void
+liuqin_fb_band(unsigned index, uint32_t color)
+{
+	/* liuqin: colour bands are off for this investigation, text only */
+	return;
+	if (!lq_fb || index > 32) {
+		return;
+	}
+	unsigned first = 182 + index * 12;
+	for (unsigned row = first; row < first + 10; row++) {
+		uint32_t *line = lq_fb + (uint64_t)row * lq_fb_stride_px;
+		for (unsigned x = 0; x < lq_fb_width; x++) {
+			line[x] = color;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+/* Identity-mapped breadcrumb for the window between the loader jump and
+ * arm_vm_init: at that point the firmware's page tables (VA == PA) are still
+ * active, so the splash framebuffer can be painted directly, before kernel_map
+ * and before anything this kernel prints has somewhere to go. */
+static void
+lq_dcache_flush(uint64_t start, uint64_t size)
+{
+	uint64_t ctr, line, addr, end;
+
+	__asm__ volatile("mrs %0, ctr_el0" : "=r"(ctr));
+	line = 4ull << ((ctr >> 16) & 0xf);
+	addr = start & ~(line - 1);
+	end = start + size;
+	for (; addr < end; addr += line) {
+		__asm__ volatile("dc civac, %0" :: "r"(addr) : "memory");
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+void
+liuqin_late_bind(uint64_t va)
+{
+	lq_fb_late = va ? (uint32_t *)(vm_offset_t)va : 0;
+}
+
+void
+liuqin_late_unbind(void)
+{
+	lq_fb_late = 0;
+}
+
+/* One unmistakable block, used for milestones reached after pmap_bootstrap
+ * (the per-stage bands need the identity mapping, this needs only lq_fb). */
+void
+liuqin_fb_bigband(unsigned first, unsigned height, uint32_t color)
+{
+	/* liuqin: colour bands are off for this investigation, text only */
+	return;
+	if (!lq_fb || first + height > 2880) {
+		return;
+	}
+	for (unsigned row = first; row < first + height; row++) {
+		uint32_t *line = lq_fb + (uint64_t)row * lq_fb_stride_px;
+		for (unsigned x = 0; x < lq_fb_width; x++) {
+			line[x] = color;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static const uint32_t lq_stage_color[8] = {
+	0xff00ffffu,	/* 0 unused, cyan */
+	0xff00ff00u,	/* 1 green   - arm_init entered */
+	0xffffff00u,	/* 2 yellow  - arm_init past the signature setup */
+	0xff0000ffu,	/* 3 blue    - arm_init before machine_startup */
+	0xffff00ffu,	/* 4 magenta - arm_init after it */
+	0xffffa500u,	/* 5 orange  - arm_vm_init entered */
+	0xffffffffu,	/* 6 white   - arm_vm_init before pmap_bootstrap */
+	0xffff0000u,	/* 7 red     - arm_vm_init after it */
+};
+
+/* Written through the identity mapping, never through a mapping this kernel
+ * installs, so it works from the first C instruction until the bootstrap
+ * tables are replaced. Each stage gets its own row band and colour. */
+void
+liuqin_early_marker(unsigned band)
+{
+	/* liuqin: colour bands are off for this investigation, text only */
+	return;
+	const uint64_t base = 0xb8000000ULL, stride = 7200;
+	uint64_t first;
+	uint32_t color;
+
+	/* Only valid while TTBR0 still holds the identity table: arm_vm_init
+	 * replaces it with an invalid one before pmap_bootstrap, so nothing below
+	 * that point may use this. */
+	if (band > 15) {
+		return;
+	}
+	first = 1200 + (uint64_t)band * 70;
+	color = lq_stage_color[band & 7];
+	for (uint64_t row = first; row < first + 44; row++) {
+		volatile uint32_t *line = lq_fb_late ? (lq_fb_late + row * 1800) :
+		    (volatile uint32_t *)(base + row * stride);
+		for (unsigned x = 0; x < 1800; x++) {
+			line[x] = color;
+		}
+	}
+	/* cache maintenance through the identity alias would fault once TTBR0 is
+	 * gone, and the late mapping is only used with the caches off anyway */
+	if (!lq_fb_late) {
+		lq_dcache_flush(base + first * stride, 44 * stride);
+	}
+}

[submodule "drivers/ArmCpu"]
	path = drivers/ArmCpu
	url = https://github.com/Chengdong-Yu/pong-arm-cpu.git
[submodule "drivers/ArmDTPlatform"]
	path = drivers/ArmDTPlatform
	url = https://github.com/Chengdong-Yu/pong-arm-dt-platform.git
[submodule "drivers/AdrenoMetal"]
	path = drivers/AdrenoMetal
	url = https://github.com/Chengdong-Yu/pong-adreno-metal.git
[submodule "drivers/NativeRamBlock"]
	path = drivers/NativeRamBlock
	url = https://github.com/Chengdong-Yu/pong-ram-block.git
[submodule "drivers/DarwinBoot24"]
	path = drivers/DarwinBoot24
	url = https://github.com/Chengdong-Yu/pong-darwin-boot24.git
# The UFS transport is vendored in this repository rather than checked out as a
# submodule: the board carries two source patches (optional pong,* property
# cross-checks and the device-derived userdata geometry) that the upstream tree
# does not have.  See drivers/NativeUfs/PongUfsTransport.cpp.
[submodule "drivers/PongAdreno"]
	path = drivers/PongAdreno
	url = https://github.com/Chengdong-Yu/pong-adreno.git
[submodule "drivers/PongBootCapture"]
	path = drivers/PongBootCapture
	url = https://github.com/Chengdong-Yu/pong-boot-capture.git
[submodule "drivers/PongMetal"]
	path = drivers/PongMetal
	url = https://github.com/Chengdong-Yu/pong-metal.git
[submodule "drivers/PongPower"]
	path = drivers/PongPower
	url = https://github.com/Chengdong-Yu/pong-power.git
[submodule "drivers/PongUsb"]
	path = drivers/PongUsb
	url = https://github.com/Chengdong-Yu/pong-usb.git
[submodule "drivers/PongWifi"]
	path = drivers/PongWifi
	url = https://github.com/Chengdong-Yu/pong-wifi.git
